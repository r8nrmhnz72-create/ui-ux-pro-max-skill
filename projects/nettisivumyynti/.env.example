# Copy these into Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
# Must use a domain you verified in Resend.
DEMO_FROM_EMAIL="Sivuseppä <demo@sivuseppa.fi>"
# Gets a copy of every demo and every failure.
OWNER_EMAIL=sinun@osoite.fi
# Public address of the site, used in email links.
SITE_URL=https://sivuseppa.fi
# Max demos per day across all visitors (each costs roughly 0.10–0.40 €).
DEMO_DAILY_LIMIT=30
# Any random string; makes the stored IP/email hashes unguessable.
DEMO_HASH_SALT=change-me
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Blob store.
